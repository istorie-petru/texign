\ExplSyntaxOff
% texign-biblio-academia.def — "Sistem de citare și referințe, conform
% normelor Academiei Române" (Editura Universității din Oradea, 2024),
% on top of biblatex-ext verbose-trad2. Loaded by texign-biblio.sty.
%
% Notes (given name, family name, italic title, volume, place, publisher,
% year, page):
%   Sabina Cantacuzino, Din viața familiei Ion C. Brătianu, vol. I,
%     București, Albatros, 1993, p. 13.
%   Robert Păiușan, Începuturile transporturilor feroviare în Balcani, în
%     Revista istorică, VIII, 1995, nr. 9-10, p. 671-677.   (both italic)
%   Paul E. Michelson, Semnificația Memorandului, în David Prodan – puterea
%     modelului, Cluj-Napoca, Fundația Culturală Română, 1995, p. 250-257.
%   Gazeta Transilvaniei, XC, nr. 33 din 1 aprilie 1925.
%   www.warmuseum.ca, 3 nov. 2004.
% Repeats: Ibidem[, p. 221]. — Idem, <other work> — <Author>, op. cit., p. —
%   <Author>, <short title>, p. (author with several works); no year: f. a.
% Bibliography: Iorga, Nicolae, O viață de om așa cum a fost, vol. I-III,
%   Chișinău, Universitas, 1991.   (alphabetical by author)
% Author helpers: \cite[Cf.][35]{key}, \cite[passim]{key}; "apud" is
% written in the note text.

% names: full "Given Family" in notes, "Family, Given" in the bibliography
\DeclareNameAlias{sortname}{family-given}
\renewcommand*{\multinamedelim}{\addcomma\space}
\renewcommand*{\finalnamedelim}{\addspace\bibstring{and}\space}
\renewcommand*{\revsdnamepunct}{\addcomma}

% every element separated by a comma; ranges with a hyphen (as in the norms)
\renewcommand*{\locpubdelim}{\addcomma\space}
\renewcommand*{\newunitpunct}{\addcomma\space}
\renewcommand*{\intitlepunct}{\space}
\DefineBibliographyExtras{romanian}{\renewcommand*{\bibrangedash}{-\nolinebreak[4]}}
\DefineBibliographyExtras{english}{\renewcommand*{\bibrangedash}{-\nolinebreak[4]}}

\DefineBibliographyStrings{romanian}{%
  page    = {p\adddot},
  pages   = {p\adddot},
  ibidem  = {ibidem},
  idem    = {idem},
  volume  = {vol\adddot},
  nodate  = {f\adddot\addnbspace a\adddot},
  urlseen = {},
}
\DeclareFieldFormat{pages}{\mkpageprefix[bookpagination]{#1}}
\DeclareFieldFormat{postnote}{\mkpageprefix[pagination]{#1}}

% titles of studies are italic like book titles (no quotation marks);
% the periodical or the collective volume is italic as well
\DeclareFieldFormat[article,incollection,inbook,inproceedings,thesis,unpublished]{title}{\mkbibemph{#1}}
\DeclareFieldFormat{journaltitle}{\mkbibemph{#1}}
\DeclareFieldFormat{booktitle}{\mkbibemph{#1}}

% periodicals: "în Revista istorică, VIII, 1995, nr. 9-10, p. 671-677";
% newspapers (entrysubtype = {newspaper}): "Gazeta Transilvaniei, XC,
% nr. 33 din 1 aprilie 1925"
\DeclareFieldFormat[article,periodical]{number}{nr\adddot\addnbspace#1}
\DeclareFieldFormat[article,periodical]{volume}{#1}
\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \setunit*{\addcomma\space}%
  \printfield{volume}%
  \setunit{\addcomma\space}%
  \iffieldequalstr{entrysubtype}{newspaper}
    {\printfield{number}%
     \setunit{\addspace din\space}%
     \printdate}
    {\printdate
     \setunit{\addcomma\space}%
     \printfield{number}}%
  \newunit}
\renewbibmacro*{issue+date}{\printdate\newunit}
% a newspaper article without an author starts with the newspaper title
\renewbibmacro*{in:}{%
  \iffieldequalstr{entrysubtype}{newspaper}
    {\ifnameundef{author}{}{\bibstring{in}\space}}
    {\bibstring{in}\space}}

% online sources: "www.warmuseum.ca, 3 noiembrie 2004."
\DeclareFieldFormat{url}{\url{#1}}
\DeclareFieldFormat{urldate}{#1}
\renewbibmacro*{url+urldate}{%
  \printfield{url}%
  \setunit{\addcomma\space}%
  \printurldate}

% no year given: "f. a." (fără an)
\renewbibmacro*{date}{%
  \iffieldundef{year}
    {\ifentrytype{online}{}{\bibstring{nodate}}}
    {\printdate}}

% the first citation of another work by the author just cited: "Idem, ..."
\renewbibmacro*{cite:full}{%
  \usebibmacro{cite:full:citepages}%
  \global\toggletrue{cbx:fullcite}%
  \printtext[bibhypertarget]{%
    \ifciteidem
      {\bibstring[\mkibid]{idem\thefield{gender}}%
       \setunit{\addcomma\space}%
       \usedriver{\DeclareNameAlias{sortname}{default}\clearname{author}}{\thefield{entrytype}}}
      {\usedriver{\DeclareNameAlias{sortname}{default}}{\thefield{entrytype}}}}%
  \usebibmacro{shorthandintro}}

% repeats: "Cristian Troncotă, op. cit., p. 50" when the author has a single
% work in the bibliography, otherwise "<Author>, <short title>, p. 50";
% Ibidem, Idem and op. cit. in italic
\renewcommand*{\mkibid}{\emph}
\renewbibmacro*{cite:title}{%
  \printtext[bibhyperlink]{%
    \ifsingletitle
      {\bibstring[\mkibid]{opcit}}
      {\printfield[citetitle]{labeltitle}}}}
\ExplSyntaxOn
