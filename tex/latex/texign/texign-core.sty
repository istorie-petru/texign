% texign-core.sty — the Texign identity shared by every document type:
% options, fonts, colours, languages and localised strings.
% Agreed values are recorded in DECISIONS.md; change them there first.
\NeedsTeXFormat{LaTeX2e}[2023-11-01]
\ProvidesExplPackage{texign-core}{2026/11/05}{0.1.0}{Texign identity core}

\sys_if_engine_luatex:F
  {
    \msg_new:nnn { texign } { engine }
      { Texign~needs~LuaLaTeX.~Compile~with~lualatex~(or~the~texign~command). }
    \msg_critical:nn { texign } { engine }
  }

\RequirePackage{texign-options}

% ---- colours (DECISIONS.md, palette B2) ------------------------------------
\RequirePackage{xcolor}
\definecolor{ink}    {HTML}{1F2328}
\definecolor{muted}  {HTML}{6A737D}
\definecolor{rule}   {HTML}{D0D4D9}
\definecolor{paper}  {HTML}{FFFFFF}
\definecolor{accent} {HTML}{963A45}
\definecolor{example}{HTML}{4F7149}
\definecolor{remark} {HTML}{647080}
\definecolor{warning}{HTML}{B0781F}
\definecolor{source} {HTML}{74624F}

% ---- fonts: IBM Plex from TeX Live, loaded by file name ----------------------
\RequirePackage{fontspec}
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\cs_new:Npn \__texign_plex:nn #1#2
  % #1 family file prefix, #2 extra features
  {
    { #1 } [ Extension = .otf , UprightFont = *-Regular , ItalicFont = *-Italic ,
      BoldFont = *-SemiBold , BoldItalicFont = *-SemiBoldItalic ,
      Scale = 0.94 , #2 ]
  }
\exp_last_unbraced:Ne \setmainfont { \__texign_plex:nn { IBMPlexSerif } { } }
\exp_last_unbraced:Ne \setsansfont { \__texign_plex:nn { IBMPlexSans } { } }
\setmonofont { IBMPlexMono }
  [ Extension = .otf , UprightFont = *-Regular , ItalicFont = *-Italic ,
    BoldFont = *-SemiBold , BoldItalicFont = *-SemiBoldItalic , Scale = 0.94 ]
\setmathfont { IBMPlexMath-Regular.otf } [ Scale = 0.94 ]
\newfontfamily \condensedfont { IBMPlexSansCondensed }
  [ Extension = .otf , UprightFont = *-Regular , ItalicFont = *-Italic ,
    BoldFont = *-SemiBold , BoldItalicFont = *-SemiBoldItalic , Scale = 0.94 ]
\NewDocumentCommand \condensed { } { \condensedfont }
% Plex has no small caps: acronyms are capitals with light tracking.
\NewDocumentCommand \acronym { m }
  { { \addfontfeatures { LetterSpace = 5 } \text_uppercase:n {#1} } }

% ---- languages ---------------------------------------------------------------
% lang=ro|en|fr selects the main language; all three are always loaded, so
% \inlang{fr}{...} and the inlanguage environment work in any document.
% babel's ini locales (independent of the optional .ldf files). Every name
% LaTeX generates comes from the tables below, set through babel, so it
% survives language switches.
\RequirePackage{babel}
\prop_const_from_keyval:Nn \c__texign_babel_prop { ro = romanian , en = english , fr = french }
\cs_new:Npn \texign_babel_name:n #1 { \prop_item:Nn \c__texign_babel_prop {#1} }
\cs_generate_variant:Nn \texign_babel_name:n { V , e }
\clist_map_inline:nn { ro , en , fr }
  {
    \str_if_eq:VnF \g_texign_lang_tl {#1}
      { \use:e { \exp_not:N \babelprovide [ import ] { \texign_babel_name:n {#1} } } }
  }
\use:e { \exp_not:N \babelprovide [ import , main ] { \texign_babel_name:V \g_texign_lang_tl } }
\RequirePackage{csquotes}
\iow_log:e { Texign~language:~\g_texign_lang_tl }

% a passage in another language: \inlang{fr}{...} or
% \begin{inlanguage}{en} ... \end{inlanguage} (hyphenation, quotes)
\NewDocumentCommand \inlang { m +m }
  { \foreignlanguage { \texign_babel_name:e { \texign_lang:n {#1} } } {#2} }
\NewDocumentEnvironment { inlanguage } { m }
  { \use:e { \exp_not:N \begin { otherlanguage* } { \texign_babel_name:e { \texign_lang:n {#1} } } } }
  { \end { otherlanguage* } }

% French spacing: the usual space typed before ; : ! ? and inside « » becomes
% unbreakable (thin before ; ! ?), so punctuation never starts a line
\lua_now:e
  {
    texign_french_language = \int_use:c { l@french } ;
    dofile ( kpse.find_file ( "texign-french.lua" ) )
  }

