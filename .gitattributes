# Normalise line endings for text files; let git decide what is text.
* text=auto eol=lf

# Binary files: no diff, no line-ending conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.otf binary

# Left out of release archives and of installs ('git archive'): the design
# exploration, repository furniture and notes for contributors.
/design         export-ignore
/.github        export-ignore
/CLAUDE.md      export-ignore
/PROPOSAL.md    export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
