% hand babel the names LaTeX prints by itself (\figurename, \contentsname...)
\cs_new_protected:Npn \__texign_caption:nnn #1#2#3
  % #1 language code, #2 babel's name for the caption, #3 our string key
  {
    \use:e
      {
        \exp_not:N \setlocalecaption { \texign_babel_name:n {#1} } {#2}
          { \prop_item:cn { g__texign_strings_#1_prop } {#3} }
      }
  }
\clist_map_inline:nn { ro , en , fr }
  {
    \__texign_caption:nnn {#1} { figure } { figure }
    \__texign_caption:nnn {#1} { table } { table }
    \__texign_caption:nnn {#1} { contents } { contents }
    \__texign_caption:nnn {#1} { listfigure } { listfigures }
    \__texign_caption:nnn {#1} { listtable } { listtables }
    \__texign_caption:nnn {#1} { bib } { bibliography }
    \__texign_caption:nnn {#1} { ref } { references }
    \__texign_caption:nnn {#1} { index } { index }
    \__texign_caption:nnn {#1} { chapter } { chapter }
    \__texign_caption:nnn {#1} { part } { part }
    \__texign_caption:nnn {#1} { appendix } { appendix }
    \__texign_caption:nnn {#1} { abstract } { abstract }
    \__texign_caption:nnn {#1} { page } { page }
    \__texign_caption:nnn {#1} { see } { see }
    \__texign_caption:nnn {#1} { also } { seealso }
    \__texign_caption:nnn {#1} { glossary } { glossary }
  }
\cs_new:Npn \texign_string:n #1
  { \prop_item:cn { g__texign_strings_ \g_texign_lang_tl _prop } {#1} }
\NewExpandableDocumentCommand \texignstring { m } { \texign_string:n {#1} }

