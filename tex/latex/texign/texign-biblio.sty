% texign-biblio.sty — bibliography and citations (biblatex + biber).
%
% One class option chooses the convention:
%   citations=notes       citations in notes, full first, short after, ibid.
%                         (biblatex-ext verbose-trad2; humanities default)
%   citations=authordate  (Murgescu 2010, 112)   (biblatex-ext authoryear)
%   citations=numeric     [3, p. 112]            (numeric-comp)
% Author commands: \cite[page]{key} (follows the convention), \textcite,
% \addbibresource{file.bib}, \printsources.
% Mark primary sources in the .bib file with  keywords = {primary}.
\NeedsTeXFormat{LaTeX2e}[2023-11-01]
\ProvidesExplPackage{texign-biblio}{2026/11/05}{0.1.0}{Texign bibliography}
\RequirePackage{texign-core}
\tl_new:N \l__texign_sortlocale_tl
\tl_set:Ne \l__texign_sortlocale_tl
  { \str_if_eq:VnTF \g_texign_lang_tl { en } { en_GB } { ro_RO } }

\str_case:VnF \g_texign_citations_tl
  {
    { authordate }
      {
        \RequirePackage
          [ backend = biber , style = ext-authoryear , autocite = inline ,
            dashed = false , maxcitenames = 2 , maxbibnames = 99 , uniquename = false ,
            sortlocale = \l__texign_sortlocale_tl , isbn = false , url = false , eprint = false ]
          { biblatex }
      }
    { numeric }
      {
        \RequirePackage
          [ backend = biber , style = numeric-comp , autocite = inline ,
            maxbibnames = 99 , sortlocale = \l__texign_sortlocale_tl , isbn = false , url = false , eprint = false ]
          { biblatex }
      }
  }
  {
    \RequirePackage
      [ backend = biber , style = ext-verbose-trad2 , autocite = footnote ,
        citetracker = context , ibidtracker = constrict , idemtracker = constrict ,
        opcittracker = context , dashed = false , maxbibnames = 99 ,
        sortlocale = \l__texign_sortlocale_tl , isbn = false , url = false , eprint = false ]
      { biblatex }
  }

% types historians use that standard biblatex styles do not define
\DeclareBibliographyAlias { legislation } { misc }
\DeclareBibliographyAlias { legal } { misc }
\DeclareBibliographyAlias { archive } { misc }

% citations that become notes go through \note, so they follow the note
% mode (margin column, footnotes or endnotes) like every other note
\str_if_eq:VnT \g_texign_citations_tl { notes }
  { \AtBeginDocument { \cs_set_protected:Npn \mkbibfootnote #1 { \note {#1} } } }
\AtBeginDocument { \cs_set_eq:NN \cite \autocite }

% ---- appearance ------------------------------------------------------------
\setlength \bibhang { 1.4em }
\setlength \bibitemsep { 3pt }
\renewcommand* \bibfont { \small }
\DeclareFieldFormat { pages } {#1}      % 45–48, not "pp. 45–48" in the bibliography
\DeclareFieldFormat { postnote } { \mkpageprefix [ pagination ] { #1 } }
\renewcommand* \mkbibnamefamily [1] {#1} % never small caps (Plex has none)
\defbibheading { texign } [ \texign_string:n { bibliography } ] { \section* {#1} }
\defbibheading { texignsub } [ ] { \subsection* {#1} }

% ---- \printsources: primary sources and secondary literature -------------
% Prints one heading; then the two groups when primary sources exist,
% otherwise a single list.
\NewDocumentCommand \printsources { }
  {
    \printbibheading [ heading = texign ]
    \printbibliography
      [ keyword = primary , heading = texignsub , title = \texign_string:n { primary } ]
    \printbibliography
      [ notkeyword = primary , heading = texignsub , title = \texign_string:n { secondary } ]
  }
