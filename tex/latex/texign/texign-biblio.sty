% texign-biblio.sty — bibliography and citations (biblatex + biber).
%
% One class option chooses the convention:
%   citations=academia          Romanian academic notes (default): N. Iorga,
%                               Titlu, București, Editura, 1928, p. 45;
%                               then Idem / Ibidem / op. cit.
%   citations=chicago           Chicago notes-bibliography (biblatex-chicago)
%   citations=chicago-authordate  Chicago author-date (biblatex-chicago)
%   citations=authordate        generic author-date (biblatex-ext)
%   citations=numeric           numeric [3, p. 112]
% Author commands: \cite[page]{key} (follows the convention), \textcite,
% \addbibresource{file.bib}, \printsources.
% Mark primary sources in the .bib file with  keywords = {primary}.
\NeedsTeXFormat{LaTeX2e}[2023-11-01]
\ProvidesExplPackage{texign-biblio}{2026/11/05}{0.2.0}{Texign bibliography}
\RequirePackage{texign-core}
\tl_new:N \l__texign_sortlocale_tl
\tl_set:Ne \l__texign_sortlocale_tl
  { \str_if_eq:VnTF \g_texign_lang_tl { en } { en_GB } { ro_RO } }
\bool_new:N \g__texign_cite_notes_bool   % citations become notes

\cs_new_protected:Npn \__texign_biblatex:n #1
  {
    \RequirePackage
      [ backend = biber , sortlocale = \l__texign_sortlocale_tl ,
        isbn = false , url = false , eprint = false , #1 ]
      { biblatex }
  }
\str_case:VnF \g_texign_citations_tl
  {
    { chicago }
      {
        \bool_gset_true:N \g__texign_cite_notes_bool
        \RequirePackage
          [ notes , backend = biber , sortlocale = \l__texign_sortlocale_tl ,
            isbn = false , url = false , eprint = false , autocite = footnote ]
          { biblatex-chicago }
      }
    { chicago-authordate }
      {
        \RequirePackage
          [ authordate , backend = biber , sortlocale = \l__texign_sortlocale_tl ,
            isbn = false , url = false , eprint = false , autocite = inline ]
          { biblatex-chicago }
      }
    { authordate }
      {
        \__texign_biblatex:n
          { style = ext-authoryear , autocite = inline , dashed = false ,
            maxcitenames = 2 , maxbibnames = 99 , uniquename = false }
      }
    { numeric }
      { \__texign_biblatex:n { style = numeric-comp , autocite = inline , maxbibnames = 99 } }
  }
  {
    % academia
    \bool_gset_true:N \g__texign_cite_notes_bool
    \__texign_biblatex:n
      { style = ext-verbose-trad2 , autocite = footnote ,
        citetracker = context , ibidtracker = constrict , idemtracker = constrict ,
        opcittracker = context , dashed = false , maxbibnames = 99 ,
        mincitenames = 1 , maxcitenames = 3 , singletitle = true ,
        citepages = omit , dateabbrev = false , urldate = long ,
        % books: a chapter starts again with a full citation (no Ibidem across chapters)
        \cs_if_exist:NT \chapter { citereset = chapter } }
  }

% citations that become notes go through \note, so they follow the note
% mode (margin column, footnotes or endnotes) like every other note
\bool_if:NT \g__texign_cite_notes_bool
  { \AtBeginDocument { \cs_set_protected:Npn \mkbibfootnote #1 { \note { \bibfootnotewrapper {#1} } } } }
% \cite is written before punctuation: "gratuit\cite[31]{lege1864}," gives
% "gratuit,¹" with notes and "gratuit (Legea 1864, 31)," inline
\AtBeginDocument
  {
    \bool_if:NTF \g__texign_cite_notes_bool
      { \cs_set_eq:NN \cite \autocite \cs_set_eq:NN \cites \autocites }
      { \DeclareDocumentCommand \cite { } { \leavevmode \unskip \space \autocite } }
  }

% types historians use that standard styles do not define
\str_if_in:NnF \g_texign_citations_tl { chicago }
  {
    \DeclareBibliographyAlias { legislation } { misc }
    \DeclareBibliographyAlias { legal } { misc }
    \DeclareBibliographyAlias { archive } { misc }
  }

% ---- appearance shared by every convention ----------------------------------
% URLs: quiet — text face, muted colour, no "https://", breakable anywhere;
% the link still points to the full address
\RequirePackage{xurl}
\urlstyle{same}
\AtBeginDocument { \hypersetup { urlcolor = muted } }
\tl_new:N \l__texign_url_tl
\cs_new_protected:Npn \texign_url:n #1
  {
    \tl_set:Nn \l__texign_url_tl {#1}
    \regex_replace_once:nnN { \A https?:// } { } \l__texign_url_tl
    \regex_replace_once:nnN { / \Z } { } \l__texign_url_tl
    \exp_args:NnV \href {#1} \l__texign_url_tl
  }
\cs_new_eq:NN \texignurl \texign_url:n
\DeclareFieldFormat { url } { \texignurl {#1} }
\setlength \bibhang { 1.4em }
\setlength \bibitemsep { 3pt }
\renewcommand* \bibfont { \small }
\renewcommand* \mkbibnamefamily [1] {#1}  % never small caps (Plex has none)
\cs_if_exist:NTF \chapter
  { \defbibheading { texign } [ \texign_string:n { bibliography } ] { \chapter* {#1} \addcontentsline { toc } { chapter } {#1} \markboth {#1} {#1} } }
  { \defbibheading { texign } [ \texign_string:n { bibliography } ] { \section* {#1} } }
\cs_if_exist:NTF \chapter
  { \defbibheading { texignsub } [ ] { \section* {#1} } }
  { \defbibheading { texignsub } [ ] { \subsection* {#1} } }

% ---- the Romanian academic convention (citations=academia) ------------------
\str_if_eq:VnT \g_texign_citations_tl { academia } { \file_input:n { texign-biblio-academia.def } }

% ---- \shortref: a compact reference for tables and timelines ---------------
% "Schnapp 1996, p. 13-17" (family name, year, page), never a note
\DeclareCiteCommand \shortref
  { \usebibmacro { prenote } }
  {
    \ifnameundef { labelname }
      { \printfield [ citetitle ] { labeltitle } }
      { \printnames [ texign-family ] [ 1-1 ] { labelname } \printtext { \addspace } \printfield { year } }
  }
  { \multicitedelim }
  { \usebibmacro { postnote } }
\DeclareNameFormat { texign-family } { \namepartfamily }

% ---- \printsources: primary sources and secondary literature -------------
% One heading; then "Surse primare" and "Literatură secundară" when primary
% sources exist, otherwise one list without subheadings.
\bool_new:N \g__texign_has_primary_bool
\defbibcheck { texign-primary } { \bool_gset_true:N \g__texign_has_primary_bool }
\NewDocumentCommand \printsources { }
  {
    \printbibheading [ heading = texign ]
    \bool_gset_false:N \g__texign_has_primary_bool
    \printbibliography
      [ keyword = primary , check = texign-primary , heading = texignsub , title = \texign_string:n { primary } ]
    \bool_if:NTF \g__texign_has_primary_bool
      {
        \printbibliography
          [ notkeyword = primary , heading = texignsub , title = \texign_string:n { secondary } ]
      }
      { \printbibliography [ notkeyword = primary , heading = none ] }
  }
